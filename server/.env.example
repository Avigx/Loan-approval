# Environment Variables for Legal Notice DMS Server

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/legal-notice-dms

# JWT secrets (generate strong random strings for production)
JWT_SECRET=your-jwt-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this

# JWT token expiration
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email provider (stub in dev — emails are logged to console)
# For production, configure Resend or SMTP
EMAIL_PROVIDER=stub
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password

# File storage mode: 'local', 's3', or 'both' (saves locally AND backs up to cloud)
STORAGE_MODE=local

# S3-compatible cloud storage configuration (Free with Cloudflare R2 or Supabase)
# For Cloudflare R2 (10 GB Free):
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=legal-notice-dms
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key

# For Supabase Storage (1 GB Free):
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_BUCKET=legal-notice-dms
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_supabase_access_key
# S3_SECRET_ACCESS_KEY=your_supabase_secret_key
# S3_FORCE_PATH_STYLE=true

# Max file upload size in bytes (25MB)
MAX_FILE_SIZE=26214400
